{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "buy-this-for-me",
	"main": "src/worker.js",
	"compatibility_date": "2026-10-25",
	// Serve static dashboard files from public/.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// Make sure /api/* always reaches the Worker instead of the asset handler.
		"run_worker_first": [
			"/api/*"
		]
	},
	// Workers.dev is enabled by default; keep it explicit.
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "buy-this-for-me",
			// Created with: npx wrangler d1 create buy-this-for-me
			"database_id": "4276c31d-3067-4616-aa53-a300dba979c5",
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
	// Optional push notifications through ntfy (see README section 7.6).
	// Only the names live here; never store values in this file.
	//   NTFY_TOPIC   - Worker secret, required to send:
	//                  npx wrangler secret put NTFY_TOPIC
	//   NTFY_SERVER  - optional plain var, defaults to https://ntfy.sh when unset;
	//                  a non-https value makes the Worker skip notifications.
}